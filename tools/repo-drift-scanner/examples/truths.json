{
  "authority_rules": [
    {"pattern": "archive/**", "authority": "historical"},
    {"pattern": "**/archive/**", "authority": "historical"},
    {"pattern": "ARCHITECTURE.md", "authority": "governing"},
    {"pattern": "README.md", "authority": "current"},
    {"pattern": "**/README.md", "authority": "current"}
  ],
  "truths": [
    {
      "id": "database",
      "description": "Current primary database",
      "canonical": "PostgreSQL",
      "stale_patterns": ["MongoDB"],
      "severity": 10
    },
    {
      "id": "api-version",
      "description": "Current public API version",
      "canonical": "v3",
      "stale_patterns": [
        {"value": "API v1", "match": "phrase"},
        {"value": "API v2", "match": "phrase"}
      ],
      "severity": 7
    },
    {
      "id": "project-name",
      "description": "Current project identity",
      "canonical": "Acme Relay",
      "stale_patterns": [
        {"value": "Project\\s+Rocket", "match": "regex"}
      ],
      "severity": 5
    }
  ],
  "suppressions": [
    {
      "path": "MIGRATION.md",
      "rule_id": "database",
      "reason": "Migration note intentionally names the previous database."
    }
  ]
}
